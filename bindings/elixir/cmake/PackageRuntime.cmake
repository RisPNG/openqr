set(refresh FALSE)
foreach(identity IN ITEMS "${OPENQR_CORE_ID}" "${OPENQR_NIF_ID}")
    get_filename_component(name "${identity}" NAME)
    file(READ "${identity}" expected)
    if(EXISTS "${OPENQR_PRIV}/${name}")
        file(READ "${OPENQR_PRIV}/${name}" current)
        if(NOT current STREQUAL expected)
            set(refresh TRUE)
        endif()
    else()
        set(refresh TRUE)
    endif()
endforeach()
get_filename_component(nif_name "${OPENQR_NIF}" NAME)
if(NOT EXISTS "${OPENQR_PRIV}/${nif_name}" OR NOT EXISTS "${OPENQR_PRIV}/${OPENQR_RUNTIME_NAME}")
    set(refresh TRUE)
endif()
if(refresh)
    file(MAKE_DIRECTORY "${OPENQR_PRIV}")
    file(COPY_FILE "${OPENQR_NIF}" "${OPENQR_PRIV}/${nif_name}" ONLY_IF_DIFFERENT)
    file(COPY_FILE "${OPENQR_RUNTIME}" "${OPENQR_PRIV}/${OPENQR_RUNTIME_NAME}" ONLY_IF_DIFFERENT)
    foreach(identity IN ITEMS "${OPENQR_CORE_ID}" "${OPENQR_NIF_ID}")
        get_filename_component(name "${identity}" NAME)
        file(COPY_FILE "${identity}" "${OPENQR_PRIV}/${name}" ONLY_IF_DIFFERENT)
    endforeach()
endif()
